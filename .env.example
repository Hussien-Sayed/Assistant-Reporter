# Tavily Search
TAVILY_API_KEY=

# Web search provider: tavily, google, or fake
WEB_SEARCH_PROVIDER=tavily

# Groq (text LLM)
GROQ_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
VISION_MODEL=llama-3.2-11b-vision-preview

# HuggingFace (embeddings)
HUGGINGFACE_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: number of results per query
TOP_K_RESULTS=5

# Search overshoot factor: fetch N * factor results to handle failures (e.g., 2 means fetch 20 to get 10)
SEARCH_OVERSHOOT_FACTOR=2
